{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "My shareable Renovate config",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "group:test",
    "group:vite",
    ":maintainLockFilesWeekly",
    ":semanticCommitTypeAll(chore)",
    "schedule:earlyMondays",
    "security:minimumReleaseAgeNpm"
  ],
  "rangeStrategy": "bump",
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "packageRules": [
    {
      "groupName": "@iconify-json",
      "matchPackageNames": [
        "@iconify-json/**"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "three.js",
      "matchPackageNames": [
        "@tresjs/**",
        "three"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": [
        "/^.*tailwindcss.*$/"
      ],
      "matchUpdateTypes": ["major"]
    }
  ]
}
